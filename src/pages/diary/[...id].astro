---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, postUrl, dateLabel, readMinutes } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post, index) => ({ params: { id: post.id }, props: { post, next: posts[index + 1] } }));
}
const { post, next } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="article-page">
    <a href="/" class="back-link">← 回到日记</a>
    <header class="article-header">
      <div class="eyebrow">{post.data.category} / JOURNAL</div>
      <h1>{post.data.title}</h1>
      <div class="entry-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>· 约 {readMinutes(post.body)} 分钟</span></div>
      {post.data.sample && <p class="sample-notice">这是一篇示例日记，用于展示版式。可在写作后台编辑或删除。</p>}
    </header>
    {post.data.cover && <img class="article-cover" src={post.data.cover} alt={post.data.coverAlt} width="900" height="600" />}
    <div class="prose"><Content /></div>
    <div class="article-end">— 记于 {dateLabel(post.data.date)} —</div>
    {next && <a class="next-post" href={postUrl(next)}><span>再读一篇</span><strong>{next.data.title}</strong><span aria-hidden="true">→</span></a>}
  </article>
</Base>
